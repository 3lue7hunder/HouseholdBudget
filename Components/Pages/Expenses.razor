@page "/expenses"
@rendermode InteractiveServer
@attribute [Authorize]
@using HouseholdBudget.Data
@using HouseholdBudget.Services
@inject BudgetService Svc

<PageTitle>Expenses</PageTitle>

<h1>Expenses</h1>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (!hasHousehold)
{
    <div class="alert alert-info">
        You need a household before you can track expenses. <a href="household">Create or join one</a>.
    </div>
}
else
{
    <div class="row g-3 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label" for="month">Month</label>
            <input id="month" type="month" class="form-control"
                   @bind="month" @bind:format="yyyy-MM" @bind:after="LoadExpensesAsync" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="StartAdd">Add expense</button>
        </div>
        <div class="col text-end">
            <span class="fs-5">Total: <strong>@Total.ToString("$#,##0.00")</strong></span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (editing is not null)
    {
        <EditForm Model="editing" OnValidSubmit="SaveAsync" class="card card-body mb-4">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <h5>@(editing.Id == 0 ? "Add expense" : "Edit expense")</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Description</label>
                    <InputText class="form-control" @bind-Value="editing.Description" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Amount</label>
                    <InputNumber class="form-control" @bind-Value="editing.Amount" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Date</label>
                    <InputDate class="form-control" @bind-Value="editing.Date" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Category</label>
                    <InputSelect class="form-select" @bind-Value="editing.CategoryId">
                        <option value="0">Select...</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12">
                    <label class="form-label">Notes (optional)</label>
                    <InputText class="form-control" @bind-Value="editing.Notes" />
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-success me-2">Save</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
    }

    @if (expenses.Count == 0)
    {
        <p class="text-muted">No expenses for this month.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Paid by</th>
                    <th class="text-end">Amount</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var e in expenses)
            {
                <tr>
                    <td>@e.Date.ToString("MMM d, yyyy")</td>
                    <td>
                        @e.Description
                        @if (!string.IsNullOrEmpty(e.Notes))
                        {
                            <div class="small text-muted">@e.Notes</div>
                        }
                    </td>
                    <td>@e.Category?.Name</td>
                    <td>@(e.PaidBy?.Name ?? "Former member")</td>
                    <td class="text-end">@e.Amount.ToString("$#,##0.00")</td>
                    <td class="text-end text-nowrap">
                        @if (confirmDeleteId == e.Id)
                        {
                            <button class="btn btn-sm btn-danger me-1" @onclick="() => DeleteAsync(e.Id)">Confirm</button>
                            <button class="btn btn-sm btn-secondary" @onclick="() => confirmDeleteId = null">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(e)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDeleteId = e.Id">Delete</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@code {
    private bool loading = true;
    private bool hasHousehold;
    private DateTime month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<Expense> expenses = new();
    private List<Category> categories = new();
    private Expense? editing;
    private int? confirmDeleteId;
    private string? error;

    private decimal Total => expenses.Sum(e => e.Amount);

    protected override async Task OnInitializedAsync()
    {
        var user = await Svc.GetCurrentUserAsync();
        hasHousehold = user?.HouseholdId is not null;

        if (hasHousehold)
        {
            categories = await Svc.GetCategoriesAsync();
            await LoadExpensesAsync();
        }

        loading = false;
    }

    private async Task LoadExpensesAsync()
    {
        expenses = await Svc.GetExpensesAsync(month.Year, month.Month);
    }

    private void StartAdd()
    {
        error = null;
        editing = new Expense { Date = DateTime.Today };
    }

    private void StartEdit(Expense e)
    {
        error = null;
        editing = new Expense
        {
            Id = e.Id,
            Description = e.Description,
            Amount = e.Amount,
            Date = e.Date,
            Notes = e.Notes,
            CategoryId = e.CategoryId
        };
    }

    private void Cancel() => editing = null;

    private async Task SaveAsync()
    {
        if (editing is null) return;

        try
        {
            await Svc.SaveExpenseAsync(editing);
            month = new DateTime(editing.Date.Year, editing.Date.Month, 1);
            editing = null;
            error = null;
            await LoadExpensesAsync();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            await Svc.DeleteExpenseAsync(id);
            confirmDeleteId = null;
            await LoadExpensesAsync();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }
}
