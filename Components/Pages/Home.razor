@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject BudgetService Svc

<PageTitle>Dashboard | Household Budget</PageTitle>

<h1>Household Budget Tracker</h1>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (loading)
{
    <p role="status">Loading...</p>
}
else if (!isAuthenticated)
{
    <p class="lead">Track shared expenses, set monthly budgets for each category, and see where your household money goes.</p>
    <a class="btn btn-primary me-2" href="Account/Register">Create account</a>
    <a class="btn btn-outline-primary" href="Account/Login">Log in</a>
}
else if (!hasHousehold)
{
    <div class="alert alert-info">
        Welcome! Start by creating a household, or join one with an invite code.
        <a href="household">Go to Household</a>
    </div>
}
else
{
    <p class="text-muted">@householdName &middot; @monthLabel</p>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center"><div class="card-body">
                <div class="text-muted">Spent this month</div>
                <div class="fs-3">@Money.Format(totalSpent)</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card text-center"><div class="card-body">
                <div class="text-muted">Total budgeted</div>
                <div class="fs-3">@Money.Format(totalBudget)</div>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card text-center"><div class="card-body">
                <div class="text-muted">Remaining</div>
                <div class="fs-3 @(totalBudget - totalSpent < 0 ? "text-danger" : "text-success")">
                    @Money.Format(totalBudget - totalSpent)
                </div>
            </div></div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <h2 class="h4">Budget status</h2>
            @if (!statuses.Any(s => s.Limit is not null))
            {
                <p class="text-muted">No budgets yet. <a href="budgets">Set some budgets</a>.</p>
            }
            else
            {
                @foreach (var s in statuses.Where(s => s.Limit is not null))
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <span>@s.CategoryName</span>
                            <span>@Money.Format(s.Spent) of @Money.Format(s.Limit!.Value)</span>
                        </div>
                        <div class="progress" role="progressbar" aria-label="@s.CategoryName budget used"
                             aria-valuenow="@BarWidth(s.Percent)" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @BarClass(s.Percent)" style="width:@(BarWidth(s.Percent))%"></div>
                        </div>
                        <div class="small text-muted">@Math.Round(s.Percent)% used@(s.Percent >= 100 ? " (over budget)" : "")</div>
                    </div>
                }
            }

            <h2 class="h4 mt-4">Spending by member</h2>
            @if (memberTotals.Count == 0)
            {
                <p class="text-muted">No expenses yet this month.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var m in memberTotals)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@m.Key</span><span>@Money.Format(m.Value)</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="col-lg-6">
            <h2 class="h4">Recent expenses</h2>
            @if (expenses.Count == 0)
            {
                <p class="text-muted">Nothing here yet. <a href="expenses">Add your first expense</a>.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm">
                        <caption class="visually-hidden">The most recent expenses this month</caption>
                        <thead class="visually-hidden">
                            <tr>
                                <th scope="col">Date</th>
                                <th scope="col">Description and category</th>
                                <th scope="col">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var e in expenses.Take(8))
                        {
                            <tr>
                                <td>@e.Date.ToString("MMM d")</td>
                                <td>@e.Description <span class="badge bg-secondary">@e.Category?.Name</span></td>
                                <td class="text-end">@Money.Format(e.Amount)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <a href="expenses">See all expenses</a>
            }
        </div>
    </div>
}

@code {
    // Tells us whether the visitor is logged in. The dashboard is only filled in for logged in users.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool loading = true;
    private bool isAuthenticated;
    private bool hasHousehold;
    private string householdName = "";
    private string monthLabel = DateTime.Today.ToString("MMMM yyyy");
    private string? error;
    private List<Expense> expenses = new();
    private List<BudgetStatus> statuses = new();
    private Dictionary<string, decimal> memberTotals = new();
    private decimal totalSpent;
    private decimal totalBudget;

    /// <summary>Loads this month's numbers for the signed-in user's household.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState is not null)
            {
                var state = await AuthState;
                isAuthenticated = state.User.Identity?.IsAuthenticated == true;
            }

            if (isAuthenticated)
            {
                var user = await Svc.GetCurrentUserAsync();
                if (user?.Household is not null)
                {
                    hasHousehold = true;
                    householdName = user.Household.Name;

                    var today = DateTime.Today;
                    expenses = await Svc.GetExpensesAsync(today.Year, today.Month);
                    statuses = await Svc.GetBudgetStatusAsync(today.Year, today.Month);

                    totalSpent = expenses.Sum(e => e.Amount);
                    totalBudget = statuses.Sum(s => s.Limit ?? 0);
                    memberTotals = expenses
                        .GroupBy(e => e.PaidBy?.Name ?? "Former member")
                        .ToDictionary(g => g.Key, g => g.Sum(e => e.Amount));
                }
            }
        }
        catch (Exception)
        {
            error = "The dashboard could not be loaded. Please refresh the page and try again.";
        }

        loading = false;
    }

    /// <summary>Green while under budget, yellow from 75%, red at 100% or more.</summary>
    private static string BarClass(double percent) =>
        percent >= 100 ? "bg-danger" : percent >= 75 ? "bg-warning" : "bg-success";

    /// <summary>Width of the bar as a whole number from 0 to 100.</summary>
    private static int BarWidth(double percent) => (int)Math.Round(Math.Min(percent, 100));
}
